#
# SwiftFormat configuration for vauchi-platform-swift.
#
# Exclude the autogenerated UniFFI binding. `vauchi_platform.swift` is
# emitted by `uniffi-bindgen` (see its "autogenerated by … the uniffi
# crate" header) and is regenerated on every bindings build — it must
# not be hand-formatted. Linting it produced thousands of lines of churn
# (e.g. redundantInit on `RustBuffer.init(...)`), so it stays excluded.
# Hand-written sources (CoreUIModels, etc.) are still linted.
--exclude Sources/VauchiPlatform/vauchi_platform.swift
